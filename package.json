{
  "name": "lichtung",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @lichtung/web",
    "dev:server": "LICHTUNG_OHNE_WEB=1 npm run dev -w @lichtung/server",
    "handy": "node scripts/dev.mjs --host",
    "start": "npm run start -w @lichtung/server",
    "passwort": "npm run passwort -w @lichtung/server",
    "build": "npm run build -w @lichtung/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces"
  }
}
